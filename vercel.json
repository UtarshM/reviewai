{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/api/v1/payments/create-public-order",
      "dest": "server.js",
      "methods": ["POST", "OPTIONS"]
    }
  ]
}
