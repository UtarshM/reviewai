# RevmeAI Server Environment Variables

# Node Server Configuration
PORT=8080
BASE_URL=https://rev.scalezix.com
JWT_SECRET=replace_with_a_secure_random_secret_key_32chars

# Database Configuration (PostgreSQL / Supabase / Neon)
# If empty, system runs on persistent JSON store engine fallback
DATABASE_URL=postgresql://postgres:password@ep-sample-123.us-east-1.aws.neon.tech/neondb?sslmode=require

# Razorpay Payment Gateway Keys (Live or Test)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_key_secret

# AI Review Generator Key (Groq Llama 3)
GROQ_API_KEY=gsk_your_groq_api_key
